# PlatformIO
.pio/
.pioenvs/
.piolibdeps/

# Editor
.vscode/
.idea/

# Generated
*.o
*.elf
*.bin
# Belt-and-braces: catch generated headers in any firmware project
# (new or renamed, at any depth — e.g. firmware/v1/ESPMaster/…) without
# needing a .gitignore bump each time.
firmware/**/BuildVersion.h
firmware/**/WebAssets.h
firmware/**/RescueAssets.h
firmware/**/WifiCredentials.h
firmware/**/MqttCredentials.h
# PlatformIO Arduino preprocessor leaves a transient *.ino.cpp in the
# project root during builds; harmless but trips the dirty check in
# build_version.py's git-rev detection.
*.ino.cpp

# Python
__pycache__/
*.pyc
.pytest_cache/
# Build-time .hex files live under .pio/ which is already ignored. The
# UnitBootloader/prebuilt/ hex is intentionally checked in, so don't
# blanket-ignore *.hex here.
.claude/
flashing/prebuilt/

# PCB design handoff zips (regenerated on demand)
PCB/*.zip

# pioarduino hybrid-compile artifacts (generated per build, IDF-owned)
firmware/v2/*/managed_components/
firmware/v2/*/sdkconfig.*
firmware/v2/*/.dummy/

# clangd tooling (machine-local: .clangd carries absolute paths; compiledb via `pio run -t compiledb`)
firmware/v2/*/.clangd
firmware/v2/*/compile_commands.json

# firmware/v2/Bootloader (#201): sdkconfig.defaults is a SOURCE file there
# (the firmware/v2/*/sdkconfig.* pattern above targets generated hybrid
# artifacts) and the dist/ bootloader is a committed build product that
# use_custom_bootloader.py embeds at 0x0.
!firmware/v2/Bootloader/sdkconfig.defaults
!firmware/v2/Bootloader/dist/*.bin
